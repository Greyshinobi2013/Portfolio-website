# Gmail SMTP Direct Ingress Configuration (for Contact Me form)
# 1. Enable 2-Step Verification on Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords (Name: "Portfolio Website")
# 3. Paste the generated 16-character password below (without spaces)
GMAIL_USER="getachewnatnael55@gmail.com"
GMAIL_APP_PASSWORD="your_16_char_app_password"

# Neon / PostgreSQL Connection (Optional)
DATABASE_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Telegram Bot Webhook Alert Credentials (Optional)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# Port (Backend API)
PORT=4000

